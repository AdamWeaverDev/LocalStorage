<?xml version="1.0" encoding="utf-8"?>
<Project>

  <PropertyGroup Label="Package Versions">
    <DotNet10Version>10.0.15</DotNet10Version>
    <DotNet11Version>11.0.0</DotNet11Version>
  </PropertyGroup>

  <!-- Resolves to the framework package line matching the current target framework -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <DotNetVersion>$(DotNet10Version)</DotNetVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <DotNetVersion>$(DotNet11Version)</DotNetVersion>
  </PropertyGroup>

  <!-- Hardening: regressions fail Release builds, vulnerable packages fail restore -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="NuGet audit">
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

</Project>
